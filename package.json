{
	"name": "@natlibfi/melinda-commons",
	"description": "Shared modules for Melinda's software",
	"author": {
		"name": "The National Library of Finland"
	},
	"keywords": [],
	"homepage": "https://www.npmjs.com/package/@natlibfi/melinda-commons",
	"bugs": {
		"url": "https://github.com/natlibfi/melinda-commons-js/issues"
	},
	"repository": {
		"url": "https://github.com/NatLibFi/melinda-commons-js"
	},
	"license": "MIT",
	"version": "16.0.0",
	"main": "./dist/index.js",
	"type": "module",
	"bin": {
		"gen-jwt-token": "./dist/gen-jwt-token.js",
		"gen-encryption-key": "./dist/gen-encryption-key.js"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsc",
		"lint": "eslint ./src",
		"lint:dev": "eslint --fix ./src",
		"test:base": "node --test --experimental-test-coverage --test-reporter=spec './src/**/*.test.ts'",
		"test": "npm run lint && npm run test:base",
		"watch:test": "cross-env DEBUG=@natlibfi/* NODE_ENV=test node --watch --test --experimental-test-coverage --test-reporter=spec './src/**/*.test.ts'",
		"dev": "npm run watch:test",
		"dev:debug": "cross-env LOG_LEVEL=debug DEBUG=@natlibfi/* NODE_ENV=test npm run watch:test"
	},
	"dependencies": {
		"@natlibfi/marc-record": "^11.0.3",
		"base64-url": "^2.3.3",
		"debug": "^4.4.3",
		"express-winston": "^4.2.0",
		"moment": "^2.31.0",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@natlibfi/fixugen": "^3.0.1",
		"@natlibfi/fixura": "^5.0.0",
		"@types/base64-url": "^2.2.2",
		"@types/debug": "^4.1.13",
		"@types/node": "^25.6.0",
		"cross-env": "^10.1.0",
		"eslint": "^10.10.0",
		"jiti": "^2.6.1",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.71.0"
	}
}
